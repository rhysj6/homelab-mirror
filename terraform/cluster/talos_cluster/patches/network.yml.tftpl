machine:
  network:
    nameservers:
      - ${dns_server}
    interfaces:
      - deviceSelector:
          physical: true
        addresses:
          - ${ip}/${subnet_size}
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}

---
apiVersion: v1alpha1
kind: HostnameConfig
hostname: ${hostname}
auto: off

---
%{ if nodetype == "controlplane" ~}
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: ${vip}
link: ${interface}
%{ endif ~}